# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_or_sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                    # from `stripe listen` or the webhook endpoint you create
PLATFORM_FEE_BPS=500                               # your cut per donation, in basis points (500 = 5%)

# Spotify (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Public site URL (used to build redirect/callback/checkout URLs)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
