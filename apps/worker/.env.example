SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-from-supabase-settings

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Optional. Euler Stream signing key (eulerstream.com). Without it the worker
# uses the free signing tier, which is fine for a few rooms but gets throttled
# as you grow. When throttled the worker backs off ~90s and retries.
EULER_API_KEY=

# Optional. When set, the worker serves GET /health on this port. Render and
# Fly set it automatically; Railway leaves it unset for background workers.
PORT=
